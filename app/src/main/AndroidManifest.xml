<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 听视频要息屏继续播,必须是前台服务(DESIGN 2.4b) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 设置页的手动更新:下完 APK 后拉起系统安装器。没有这条,startActivity 会被
         PackageInstaller 直接拒绝。它不是后台静默安装 —— 装不装仍然由系统的安装确认页
         问用户。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- enableOnBackInvokedCallback 是预测式返回的开关。不开这一条,系统仍走旧的
         onBackPressed 通路,NavDisplay 的 predictivePopTransitionSpec 拿不到手势进度,
         返回动画只能在松手之后整段播完,手势期间屏幕上什么都不动。 -->
    <application
        android:name=".BilbyApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bilby">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Bilby">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B 站链接。**只登记 UGC 会出现的那几个 host**,不登记整个 bilibili.com 的
                 所有路径:番剧/影视/课堂是 Non-Goal(版权),把它们的链接也抢过来只会得到
                 一个打不开的页面,而用户已经失去了选择用别的应用打开的机会。
                 autoVerify 没开:那需要在服务端放 assetlinks.json,而域名不是我们的。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="b23.tv" />
                <data android:host="bili2233.cn" />
                <data android:host="live.bilibili.com" />
                <data android:host="space.bilibili.com" />
                <data android:host="www.bilibili.com" android:pathPrefix="/video/" />
                <data android:host="m.bilibili.com" android:pathPrefix="/video/" />
                <data android:host="bilibili.com" android:pathPrefix="/video/" />
            </intent-filter>

            <!-- 从别的应用分享过来的那段文字。B 站客户端复制的是
                 「【标题】 https://b23.tv/xxx 复制这段内容…」,链接要从里面挑出来。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".player.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 安装器是另一个进程,递 file:// 会触发 FileUriExposedException(N 起)。
             唯一的合法通路是 content:// + 临时读权限,而那需要一个 FileProvider。
             authority 带上 applicationId,好让 debug 与 release 能同时装在一台机器上 ——
             两个 APK 声明同一个 authority 的话,后装的那个会直接安装失败。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
