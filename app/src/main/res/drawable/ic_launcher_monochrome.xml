<?xml version="1.0" encoding="utf-8"?>
<!--
  主题图标层。几何与 ic_launcher_foreground 完全相同,单独存一份而不是复用前景,
  因为这两层的约束不一样:前景可以是彩色的、可以分层次,而这一层会被系统按用户壁纸取色
  **整体染成一个颜色**,只有 alpha 有意义。

  之前的写法是让 <monochrome> 直接指向前景层。那次侥幸能用(前景本来就是纯白单色),
  但那是巧合不是设计——前景一旦加入第二个颜色,主题图标就会糊成一整块。

  这里的 fillColor 用什么颜色无所谓,系统会覆盖;写黑色是惯例,方便在编辑器里预览剪影。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#000000"
        android:fillType="evenOdd"
        android:pathData="M39,40 H54.5 A10.5,10.5 0 0 1 54.5,61 H56.5 A11.5,11.5 0 0 1 56.5,84 H39 Z M56,46.1 A2.4,2.9 0 0 1 56,51.9 A2.4,2.9 0 0 1 56,46.1 Z M57.75,47.9 A0.85,0.85 0 0 1 56.05,47.9 A0.85,0.85 0 0 1 57.75,47.9 Z" />

    <path
        android:strokeColor="#000000"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M45,41 C43,35.5 41.5,32 41,28" />

    <path
        android:strokeColor="#000000"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M56,41 C58.5,35.5 60.8,31.5 62,28" />

</vector>
